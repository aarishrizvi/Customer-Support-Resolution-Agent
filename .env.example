# Firebase Configuration (from Firebase Console > Project Settings > General > Your apps > Web app)
# Do NOT commit actual values to Git. Copy this file to .env.local and fill in your values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Firebase Measurement ID (for Analytics)
# VITE_FIREBASE_MEASUREMENT_ID=

# Gemini AI API Key (for AI resolution engine)
# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Override AI model chain (comma-separated)
# RESOLVE_AI_MODELS=gemini-3.8-flash,gemini-3.7-flash

# Optional: App URL for production (used for OAuth callbacks, etc.)
# APP_URL=