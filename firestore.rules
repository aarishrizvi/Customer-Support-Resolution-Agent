rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSupportAgent() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/agents/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPPORT_AGENT')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Users Collection: public register enforces role == 'CUSTOMER'
    match /users/{userId} {
      allow get: if isOwner(userId) || isSupportAgent();
      allow list: if isSupportAgent();
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || request.resource.data.role == 'CUSTOMER'
      );
      allow update: if isOwner(userId) || isSupportAgent();
      allow delete: if false;
    }

    // Support Agents Collection
    match /agents/{agentId} {
      allow read: if isSignedIn();
      allow write: if isSupportAgent();
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow get: if isSupportAgent() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow list: if isSupportAgent() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && (
        isSupportAgent() || 
        (request.resource.data.customerId == request.auth.uid)
      );
      allow update: if isSupportAgent() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow delete: if isSupportAgent();

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isSupportAgent() || (
          isSignedIn() && 
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid
        );
        allow create: if isSupportAgent() || (
          isSignedIn() && 
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid
        );
        allow update: if isSupportAgent();
        allow delete: if isSupportAgent();
      }
    }

    // Knowledge Base
    match /knowledgeBase/{articleId} {
      allow read: if true;
      allow write: if isSupportAgent();
    }

    // Customer Profiles
    match /customers/{customerId} {
      allow read: if isSupportAgent() || isOwner(customerId);
      allow write: if isSupportAgent();
    }

    // Activity Log
    match /activities/{activityId} {
      allow read: if isSupportAgent();
      allow create: if isSignedIn();
      allow update, delete: if isSupportAgent();
    }
  }
}
